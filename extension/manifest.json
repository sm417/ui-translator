{
  "manifest_version": 3,
  "name": "界面翻译 · UI Translator",
  "version": "1.2.0",
  "description": "只翻界面文字、自动跳过代码块。点一次之后新页面自动翻译；支持腾讯免费翻译与大模型翻译，替换/双语两种显示，悬停可看原文。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "界面翻译 (Alt+T)"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "翻译 / 还原当前页面"
    }
  }
}
